# macOS
.DS_Store

# Go build output
/soroauth
/cmd/soroauth/soroauth
*.test
*.out
/bin/
/_site/
/packages.txt

# Node (golden-vector generator, typescript wrapper)
node_modules/
.tools/

# Rust (e2e test contract)
target/

# Soroban test snapshots are regenerated by every `cargo test` run and are not
# part of the fixture's contract with anything.
test_snapshots/

# Python bytecode
__pycache__/
*.pyc

# Python virtualenvs for the parity harness
.venv/
.venv-parity/

# A local e2e run writes its results here; testnet owns the committed
# e2e/RESULTS.md. See e2e/README.md.
e2e/RESULTS.local.md
e2e/parity-report.json

# WebAssembly build output (regenerated by wasm/build.sh)
wasm/dist/
wasm/ts/dist/

# JVM native libraries (built by bindings/jvm/native/build.sh, exercised by
# NativeSoroauthTest, never committed)
bindings/jvm/src/main/resources/native/
