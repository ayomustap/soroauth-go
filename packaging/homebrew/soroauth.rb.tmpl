# This formula is generated by scripts/gen-formula.sh from a release's
# checksums.txt, using the template in packaging/homebrew/soroauth.rb.tmpl.
#
# Do not edit it by hand. The release workflow regenerates it on every `v*` tag
# and pushes the result to the tap, so an edit is overwritten on the next
# release; a change to how the CLI is packaged belongs in the template.
#
# The formula installs the released binary, so `soroauth --version` reports the
# released tag and the tap needs no Go toolchain.
class Soroauth < Formula
  desc "Build, sign and inspect Soroban authorization entries"
  homepage "https://github.com/soroauth/soroauth-go"
  version "@@VERSION@@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "@@BASE_URL@@/soroauth-darwin-arm64.tar.gz"
      sha256 "@@SHA_DARWIN_ARM64@@"
    end
    on_intel do
      url "@@BASE_URL@@/soroauth-darwin-amd64.tar.gz"
      sha256 "@@SHA_DARWIN_AMD64@@"
    end
  end

  on_linux do
    on_arm do
      url "@@BASE_URL@@/soroauth-linux-arm64.tar.gz"
      sha256 "@@SHA_LINUX_ARM64@@"
    end
    on_intel do
      url "@@BASE_URL@@/soroauth-linux-amd64.tar.gz"
      sha256 "@@SHA_LINUX_AMD64@@"
    end
  end

  def install
    # The tarball carries the binary at its top level, named `soroauth`, so no
    # rename is needed here and Homebrew never has to guess an extension for a
    # bare file.
    bin.install "soroauth"
  end

  test do
    # The whole point of the package: it runs and reports the released version.
    assert_match version.to_s, shell_output("#{bin}/soroauth --version")
  end
end
